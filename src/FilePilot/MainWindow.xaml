<Window x:Class="FilePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="FilePilot" Height="820" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#14171c" Foreground="#e2e8f0"
        FontFamily="Segoe UI, Tahoma, Arial"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dark ScrollBar Styles -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#181b22"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222630"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderBrush" Value="#2d3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2d3545"/>
                    <Setter Property="BorderBrush" Value="#3b82f6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1e2430"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header Button Style -->
        <Style x:Key="HeaderBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" Background="#161922" BorderBrush="#3b4354" BorderThickness="1.5" CornerRadius="3">
                                <Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 13 4" Stroke="#3b82f6" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter TargetName="Box" Property="Background" Value="#1e293b"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#60a5fa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Root Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Custom Title Bar -->
            <RowDefinition Height="36"/>
            <!-- 1. Navigation & Action Toolbar -->
            <RowDefinition Height="46"/>
            <!-- 2. Main Workspace -->
            <RowDefinition Height="*"/>
            <!-- 3. Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 0. CUSTOM DARK FILEPILOT TITLE BAR (Only title bar displayed) -->
        <Grid Grid.Row="0" Background="#101317" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="FilePilot" FontWeight="Bold" FontSize="13" Foreground="#f8fafc" VerticalAlignment="Center"/>
                <Border Background="#1e3a5f" CornerRadius="3" Margin="8,0,0,0" Padding="5,1">
                    <TextBlock Text="v6.5" FontSize="10" Foreground="#60a5fa" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ActiveTab.CurrentPath}" 
                       Foreground="#64748b" FontSize="11" VerticalAlignment="Center" 
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="20,0"/>

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="—" Width="40" Height="36" Style="{StaticResource HeaderBtn}" Click="BtnMinimize_Click"/>
                <Button Content="🗖" Width="40" Height="36" Style="{StaticResource HeaderBtn}" Click="BtnMaximize_Click"/>
                <Button Content="✕" Width="40" Height="36" Style="{StaticResource HeaderBtn}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- 1. NAVIGATION & ACTION TOOLBAR -->
        <Grid Grid.Row="1" Background="#181c23" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nav Buttons -->
            <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <Button Content="◀" ToolTip="Back (Alt+Left)" Width="30" Height="30" Margin="2,0" Click="BtnBack_Click"/>
                <Button Content="▶" ToolTip="Forward (Alt+Right)" Width="30" Height="30" Margin="2,0" Click="BtnForward_Click"/>
                <Button Content="▲" ToolTip="Up to Parent (Alt+Up / Backspace)" Width="30" Height="30" Margin="2,0" Click="BtnUp_Click"/>
                <Button Content="🔄" ToolTip="Refresh (F5)" Width="30" Height="30" Margin="2,0" Click="BtnRefresh_Click"/>
            </StackPanel>

            <!-- Path Bar -->
            <Grid Grid.Column="1" Margin="4,7" VerticalAlignment="Center">
                <TextBox x:Name="TxtPath" Text="{Binding ActiveTab.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         Background="#12151b" Foreground="#f1f5f9" BorderBrush="#2b323f" BorderThickness="1"
                         Padding="10,5" FontSize="13" VerticalContentAlignment="Center"
                         KeyDown="TxtPath_KeyDown"/>
            </Grid>

            <!-- Search Filter & Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                <!-- Search Box (Shortcut: /) -->
                <Grid Width="220" Margin="4,0">
                    <TextBox x:Name="TxtFilter" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#12151b" Foreground="#f1f5f9" BorderBrush="#2b323f" BorderThickness="1"
                             Padding="8,5" FontSize="12" VerticalContentAlignment="Center"
                             PreviewKeyDown="TxtFilter_PreviewKeyDown"/>
                    <TextBlock Text="🔍 Press / to search..." Foreground="#64748b" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox Content="Subfolders" IsChecked="{Binding SearchSubfolders}" 
                          Foreground="#94a3b8" VerticalAlignment="Center" Margin="6,0"
                          ToolTip="Search recursively through all subfolders"/>

                <!-- Action Buttons -->
                <Button Content="📁+ Folder" ToolTip="New Folder (Ctrl+Shift+N)" Margin="2,0" Click="BtnNewFolder_Click"/>
                <Button Content="📄+ File" ToolTip="New File (Ctrl+N)" Margin="2,0" Click="BtnNewFile_Click"/>
                <Button Content="📋 Paste" ToolTip="Paste (Ctrl+V)" Margin="2,0" Click="BtnPaste_Click"/>
                <Button Content="⚡ Commands" ToolTip="Command Palette (Ctrl+P / F1)" Margin="2,0" Click="BtnCommands_Click"/>
                <Button Content="👁️ Inspector" ToolTip="Toggle Inspector (Ctrl+I)" Margin="2,0" Click="BtnInspector_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Quick Access Sidebar -->
                <ColumnDefinition Width="220" MinWidth="140" MaxWidth="360"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="3"/>
                <!-- File Browser View -->
                <ColumnDefinition Width="*"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="Auto"/>
                <!-- Inspector Sidebar -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: QUICK ACCESS SIDEBAR -->
            <Border Grid.Column="0" Background="#161920" BorderBrush="#232834" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Storage -->
                        <TextBlock Text="STORAGE" FontWeight="Bold" FontSize="11" Foreground="#64748b" Margin="4,8,4,4"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1b1f28" CornerRadius="4" Margin="0,2" Padding="6,4" Cursor="Hand" MouseDown="Drive_MouseDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#f1f5f9"/>
                                                <TextBlock Text="{Binding Label}" Foreground="#94a3b8" Margin="6,0,0,0" FontSize="11"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Row="1" Value="{Binding PercentUsed}" Maximum="100" Height="4" 
                                                         Background="#29303d" Foreground="#3b82f6" Margin="0,4,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Places -->
                        <TextBlock Text="PLACES" FontWeight="Bold" FontSize="11" Foreground="#64748b" Margin="4,14,4,4"/>
                        <ItemsControl ItemsSource="{Binding Places}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="4" Margin="0,1" Padding="6,4" Cursor="Hand" MouseDown="QuickAccessItem_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#cbd5e1" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bookmarks -->
                        <Grid Margin="4,14,4,4">
                            <TextBlock Text="BOOKMARKS" FontWeight="Bold" FontSize="11" Foreground="#64748b"/>
                            <Button Content="+ Pin" HorizontalAlignment="Right" Padding="4,1" FontSize="10" Click="BtnPinBookmark_Click"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="4" Margin="0,1" Padding="6,4" Cursor="Hand" MouseDown="QuickAccessItem_MouseDown">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}" Foreground="#cbd5e1" FontSize="12"/>
                                            </StackPanel>
                                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                                                    Foreground="#64748b" Padding="4,0" FontSize="10" Click="BtnRemoveBookmark_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Recents -->
                        <TextBlock Text="RECENTS" FontWeight="Bold" FontSize="11" Foreground="#64748b" Margin="4,14,4,4"/>
                        <ItemsControl ItemsSource="{Binding Recents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="4" Margin="0,1" Padding="6,4" Cursor="Hand" MouseDown="QuickAccessItem_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#94a3b8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#232834"/>

            <!-- CENTER: TABS + FILE BROWSER -->
            <Grid Grid.Column="2" Background="#181c24">
                <Grid.RowDefinitions>
                    <!-- Tabs Bar -->
                    <RowDefinition Height="34"/>
                    <!-- Async Loading Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- File Items List -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tabs Bar -->
                <Grid Grid.Row="0" Background="#14171e">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1,2,1,0" CornerRadius="4,4,0,0" Padding="8,4" Cursor="Hand" MouseDown="Tab_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1b1f28"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#1e232d"/>
                                                        <Setter Property="BorderBrush" Value="#3b82f6"/>
                                                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,6,0" FontSize="11"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#f1f5f9" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                            <Button Content="✕" Width="16" Height="16" Style="{StaticResource HeaderBtn}" Padding="0" FontSize="10" Click="BtnCloseTab_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- New Tab Button -->
                        <Button Content="+" Width="28" Height="26" Margin="4,3" Style="{StaticResource HeaderBtn}" FontWeight="Bold" FontSize="14" Click="BtnNewTab_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Async Loading Bar -->
                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Background="Transparent" Foreground="#3b82f6" BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- File Items List (DataGrid) with Custom Selection & CheckBoxes -->
                <DataGrid Grid.Row="2" x:Name="GridFiles"
                          ItemsSource="{Binding DisplayItems}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          Sorting="DataGrid_Sorting"
                          SelectionMode="Extended"
                          Background="#1a1e27"
                          RowBackground="#1a1e27"
                          AlternatingRowBackground="#1e222b"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#222733"
                          MouseDoubleClick="GridFiles_MouseDoubleClick"
                          PreviewKeyDown="GridFiles_PreviewKeyDown">

                    <!-- Elimination of White Selection via SystemColor overrides -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#25354d"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1c2738"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#e2e8f0"/>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#151821"/>
                            <Setter Property="Foreground" Value="#94a3b8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderBrush" Value="#222733"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Row Style with Sleek Dark Navy Blue Selection -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#25354d"/>
                                    <Setter Property="BorderBrush" Value="#3b82f6"/>
                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#222834"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Cell Style without White Highlight -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#25354d"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Context Menu -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#1e232d" Foreground="#f1f5f9" BorderBrush="#2e3748">
                            <MenuItem Header="Open" Click="MenuOpen_Click" FontWeight="Bold"/>
                            <MenuItem Header="Expand / Collapse (Ctrl+E)" Click="MenuExpand_Click"/>
                            <MenuItem Header="Open with Explorer (Alt+E)" Click="MenuOpenExplorer_Click"/>
                            <MenuItem Header="Open in Terminal (Ctrl+`)" Click="MenuOpenTerminal_Click"/>
                            <Separator Background="#2e3748"/>
                            <MenuItem Header="Copy (Ctrl+C)" Click="MenuCopy_Click"/>
                            <MenuItem Header="Cut (Ctrl+X)" Click="MenuCut_Click"/>
                            <MenuItem Header="Paste (Ctrl+V)" Click="BtnPaste_Click"/>
                            <Separator Background="#2e3748"/>
                            <MenuItem Header="Rename (F2)" Click="MenuRename_Click"/>
                            <MenuItem Header="Delete to Recycle Bin (Del)" Click="MenuDelete_Click"/>
                            <MenuItem Header="Permanently Delete (Shift+Del)" Click="MenuPermanentDelete_Click"/>
                            <Separator Background="#2e3748"/>
                            <MenuItem Header="Pin to Bookmarks" Click="BtnPinBookmark_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- 1. CHECKBOX COLUMN -->
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="ChkHeaderSelectAll" Click="ChkHeaderSelectAll_Click" ToolTip="Select / Deselect All"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. IN-LINE TREE EXPANDER + ICON -->
                        <DataGridTemplateColumn Header="" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Expand/Collapse arrow for folders -->
                                        <TextBlock Text="{Binding IsExpanded, Converter={x:Null}}" 
                                                   FontSize="10" Foreground="#94a3b8" Margin="0,0,4,0" Cursor="Hand"
                                                   MouseDown="Expander_MouseDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▸"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="▾"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding IconKind}" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. NAME (WITH TREE INDENTATION & FULL PERSIAN UNICODE RENDERING) -->
                        <DataGridTemplateColumn Header="Name" Width="3*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Indentation block for tree levels -->
                                        <Border Width="{Binding IndentLevel, Converter={x:Null}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                            <Setter Property="Width" Value="16"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IndentLevel}" Value="2">
                                                            <Setter Property="Width" Value="32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IndentLevel}" Value="3">
                                                            <Setter Property="Width" Value="48"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="#f8fafc" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. SIZE -->
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" SortMemberPath="Size">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 5. TYPE -->
                        <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="90" SortMemberPath="Extension">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 6. DATE MODIFIED -->
                        <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" SortMemberPath="DateModified">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748b"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 7. DATE CREATED -->
                        <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreated, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" SortMemberPath="DateCreated">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748b"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- SPLITTER 2 (Inspector) -->
            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch" Background="#232834">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectorVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- RIGHT: INSPECTOR & PREVIEW PANEL -->
            <Border Grid.Column="4" Background="#161921" Width="320" BorderBrush="#232834" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectorVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="INSPECTOR" FontWeight="Bold" FontSize="12" Foreground="#94a3b8"/>
                            <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource HeaderBtn}" Click="BtnInspector_Click"/>
                        </Grid>

                        <!-- Selected File Info -->
                        <Border Background="#1d222c" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItem.Name, FallbackValue='No Selection'}" 
                                           FontWeight="Bold" FontSize="13" Foreground="#f8fafc" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.FormattedSize, FallbackValue='--'}" 
                                           Foreground="#94a3b8" Margin="0,2,0,6" FontSize="11"/>
                                
                                <TextBlock Text="Full Path:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding SelectedItem.FullPath}" FontSize="10" Foreground="#cbd5e1" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <TextBlock Text="Modified:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding SelectedItem.DateModified, StringFormat={}{0:F}}" FontSize="10" Foreground="#cbd5e1" Margin="0,0,0,6"/>

                                <TextBlock Text="SHA-256:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding InspectorSha256}" FontSize="9" Foreground="#94a3b8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Preview -->
                        <Border Background="#12151b" CornerRadius="4" Margin="0,0,0,10" MaxHeight="220"
                                Visibility="{Binding InspectorImage, Converter={x:Null}}">
                            <Image Source="{Binding InspectorImage}" Stretch="Uniform"/>
                        </Border>

                        <!-- Text Preview -->
                        <TextBlock Text="CONTENT PREVIEW" FontWeight="Bold" FontSize="11" Foreground="#64748b" Margin="0,4,0,4"/>
                        <Border Background="#12151b" BorderBrush="#242b38" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="160">
                            <TextBox Text="{Binding InspectorContent}" IsReadOnly="True" 
                                     Background="Transparent" Foreground="#e2e8f0" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, Tahoma" FontSize="11"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InspectorIsRtl}" Value="True">
                                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Grid Grid.Row="3" Background="#101317" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="FilePilot 6.5" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 4. COMMAND PALETTE OVERLAY (ALWAYS ON TOP IN FRONT OF ADDRESS BAR, Z-INDEX 99999) -->
        <Grid x:Name="CommandPaletteOverlay" 
              Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="99999"
              Visibility="Collapsed" Background="#80000000"
              MouseDown="CommandPaletteOverlay_MouseDown">
            <Border Width="580" Height="420" Background="#161921" BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseDown="CommandPaletteModal_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
                </Border.Effect>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <TextBox x:Name="TxtCmdSearch" 
                             Background="#101218" Foreground="#f8fafc" BorderBrush="#3b82f6" BorderThickness="1"
                             Padding="12,9" FontSize="14" Margin="0,0,0,12"
                             TextChanged="TxtCmdSearch_TextChanged" KeyDown="TxtCmdSearch_KeyDown"/>

                    <!-- Commands List -->
                    <ListBox Grid.Row="1" x:Name="ListCommands" Background="Transparent" BorderThickness="0"
                             Foreground="#e2e8f0" MouseDoubleClick="ListCommands_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#25354d"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1d232e"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#f1f5f9"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#263142" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="#60a5fa" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
